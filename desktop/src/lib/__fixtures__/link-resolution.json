{
  "about": "Which file a link points at. Read by the frontend tests (link-updates.test.ts, link-resolve.test.ts) and the Rust test (links.rs), so the resolver that opens a link and the one that rewrites links on rename cannot drift apart. `notes` and `cases` are wiki links to notes, by name or path. `vault` and `links` are a second vault with other files in it, for links that depend on the note they are written in: `markdown` is the text between ]( and ), `wiki` the file part of a [[link]], and `from` the note it is in. Files are listed as vault-relative paths; both sides sort them the way fs_list_all_files does before resolving.",
  "notes": [
    "Projects/Plan.md",
    "Inbox.md",
    "Archive/Plan.md",
    "Archive/2025/Plan.md",
    "Notes/C# basics.md",
    "Notes/v1.2 plan.md",
    "Daily Notes/2026-11-13.md",
    "Notes/Old Style.markdown",
    "Projects/Deep/Spec.md",
    "plan/Readme.md",
    "Ünïcode/Café.md"
  ],
  "cases": [
    { "target": "Inbox", "expect": "Inbox.md" },
    { "target": "inbox", "expect": "Inbox.md" },
    { "target": "Inbox.md", "expect": "Inbox.md" },
    { "target": "INBOX.MD", "expect": "Inbox.md" },
    { "target": "Plan", "expect": "Archive/2025/Plan.md", "why": "three notes share the name; the first in listing order wins" },
    { "target": "Projects/Plan", "expect": "Projects/Plan.md" },
    { "target": "projects/plan.md", "expect": "Projects/Plan.md" },
    { "target": "Archive/Plan", "expect": "Archive/Plan.md" },
    { "target": "2025/Plan", "expect": null, "why": "a path must be the whole path inside the vault, not the end of one" },
    { "target": "Deep/Spec", "expect": null },
    { "target": "Spec", "expect": "Projects/Deep/Spec.md" },
    { "target": "Projects/Deep/Spec", "expect": "Projects/Deep/Spec.md" },
    { "target": "Projects\\Deep\\Spec", "expect": "Projects/Deep/Spec.md", "why": "backslashes are read as path separators" },
    { "target": "C# basics", "expect": "Notes/C# basics.md" },
    { "target": "v1.2 plan", "expect": "Notes/v1.2 plan.md" },
    { "target": "Old Style", "expect": "Notes/Old Style.markdown" },
    { "target": "Old Style.markdown", "expect": "Notes/Old Style.markdown" },
    { "target": "2026-11-13", "expect": "Daily Notes/2026-11-13.md" },
    { "target": "Readme", "expect": "plan/Readme.md" },
    { "target": "plan/Readme", "expect": "plan/Readme.md" },
    { "target": "Café", "expect": "Ünïcode/Café.md" },
    { "target": "ünïcode/café", "expect": "Ünïcode/Café.md" },
    { "target": "Missing", "expect": null },
    { "target": "", "expect": null }
  ],
  "vault": [
    "Archive/Plan.md",
    "Deep/Spec.md",
    "Inbox.md",
    "Notes/100% done.md",
    "Notes/50%25 off.md",
    "Notes/C# basics.md",
    "Notes/My note (draft).md",
    "Notes/Old Style.markdown",
    "Plan.md",
    "Projects/Deep/Draft.md",
    "Projects/Deep/Spec.md",
    "Projects/Notes.md",
    "Projects/Plan.md",
    "Projects/img/chart.png",
    "Projects/img/photo.png",
    "attachments/photo.png",
    "attachments/team photo.png",
    "paper.pdf",
    "Ünïcode/Café.md"
  ],
  "links": [
    { "from": "Projects/Notes.md", "markdown": "/Projects/Plan.md", "expect": "Projects/Plan.md", "why": "a leading / is a path from the top of the vault" },
    { "from": "Projects/Notes.md", "markdown": "/projects/plan", "expect": "Projects/Plan.md", "why": "letter case is ignored and a note's .md may be left off" },
    { "from": "Projects/Notes.md", "markdown": "/Plan.md", "expect": "Plan.md" },
    { "from": "Projects/Notes.md", "markdown": "/attachments/photo.png", "expect": "attachments/photo.png" },
    { "from": "Projects/Notes.md", "markdown": "/Missing.md", "expect": null },
    { "from": "Projects/Notes.md", "markdown": "/Notes.md", "expect": null, "why": "a leading / is never read from the note's folder" },
    { "from": "Projects/Notes.md", "markdown": "./Plan.md", "expect": "Projects/Plan.md", "why": "./ is the folder of the note the link is in" },
    { "from": "Projects/Notes.md", "markdown": "./Plan", "expect": "Projects/Plan.md" },
    { "from": "Projects/Notes.md", "markdown": "../Plan.md", "expect": "Plan.md" },
    { "from": "Projects/Notes.md", "markdown": "../../Plan.md", "expect": null, "why": "a path that climbs out of the vault points at nothing" },
    { "from": "Projects/Notes.md", "markdown": "./Deep/../Plan.md", "expect": "Projects/Plan.md" },
    { "from": "Projects/Notes.md", "markdown": "./img/photo.png", "expect": "Projects/img/photo.png" },
    { "from": "Projects/Notes.md", "markdown": "../attachments/photo.png", "expect": "attachments/photo.png" },
    { "from": "Projects/Notes.md", "markdown": "./attachments/photo.png", "expect": "attachments/photo.png", "why": "nothing is at Projects/attachments, so ./ is read from the top of the vault, as it was before relative paths were understood" },
    { "from": "Projects/Deep/Spec.md", "markdown": "../attachments/photo.png", "expect": null, "why": "../ has no such older reading" },
    { "from": "Projects/Deep/Spec.md", "markdown": "../../Deep/Spec.md", "expect": "Deep/Spec.md" },
    { "from": "Inbox.md", "markdown": "./Plan.md", "expect": "Plan.md" },
    { "from": "Inbox.md", "markdown": "../Plan.md", "expect": null },
    { "from": "Projects/Notes.md", "markdown": "Plan.md", "expect": "Plan.md", "why": "a plain path is read from the top of the vault first" },
    { "from": "Projects/Notes.md", "markdown": "Deep/Spec.md", "expect": "Deep/Spec.md", "why": "the top of the vault wins over the note's folder" },
    { "from": "Projects/Notes.md", "markdown": "Deep/Draft.md", "expect": "Projects/Deep/Draft.md", "why": "nothing at the top, so from the note's folder" },
    { "from": "Projects/Notes.md", "markdown": "Deep/Draft", "expect": "Projects/Deep/Draft.md" },
    { "from": "Projects/Notes.md", "markdown": "img/chart.png", "expect": "Projects/img/chart.png" },
    { "from": "Projects/Deep/Spec.md", "markdown": "Draft.md", "expect": "Projects/Deep/Draft.md" },
    { "from": "Inbox.md", "markdown": "Draft.md", "expect": "Projects/Deep/Draft.md", "why": "a bare name with nothing at either place is found the way a wiki link finds it" },
    { "from": "Inbox.md", "markdown": "Draft", "expect": "Projects/Deep/Draft.md" },
    { "from": "Inbox.md", "markdown": "Deep/Draft.md", "expect": null, "why": "a path is not found by its name" },
    { "from": "Inbox.md", "markdown": "photo.png", "expect": "attachments/photo.png", "why": "by name, the shallowest file wins" },
    { "from": "Projects/Notes.md", "markdown": "Spec.md", "expect": "Deep/Spec.md", "why": "by name, the first note in listing order wins" },
    { "from": "Projects/Notes.md", "markdown": "Projects/Plan.md", "expect": "Projects/Plan.md" },
    { "from": "Projects/Notes.md", "markdown": "projects/PLAN.MD", "expect": "Projects/Plan.md" },
    { "from": "Inbox.md", "markdown": "Projects/Deep/../Plan.md", "expect": "Projects/Plan.md" },
    { "from": "Inbox.md", "markdown": "Missing.md", "expect": null },
    { "from": "Archive/Plan.md", "markdown": "Plan.md", "expect": "Plan.md", "why": "the top of the vault wins over the note itself" },
    { "from": "Inbox.md", "markdown": "attachments/team%20photo.png", "expect": "attachments/team photo.png" },
    { "from": "Inbox.md", "markdown": "attachments/team photo.png", "expect": "attachments/team photo.png", "why": "a space written as it is" },
    { "from": "Inbox.md", "markdown": "attachments/team photo.png \"The team\"", "expect": "attachments/team photo.png", "why": "a title is a quoted string at the end" },
    { "from": "Inbox.md", "markdown": "attachments/photo.png 'x'", "expect": "attachments/photo.png" },
    { "from": "Inbox.md", "markdown": "<attachments/team photo.png>", "expect": "attachments/team photo.png" },
    { "from": "Inbox.md", "markdown": "<attachments/team photo.png> \"The team\"", "expect": "attachments/team photo.png" },
    { "from": "Inbox.md", "markdown": "  attachments/photo.png  ", "expect": "attachments/photo.png" },
    { "from": "Inbox.md", "markdown": "Notes/C%23%20basics.md#Types", "expect": "Notes/C# basics.md", "fragment": "#Types" },
    { "from": "Inbox.md", "markdown": "Notes/C# basics.md", "expect": null, "fragment": "# basics.md", "why": "the first # starts the heading, so a # in a name has to be written %23" },
    { "from": "Inbox.md", "markdown": "Notes/100%25%20done.md", "expect": "Notes/100% done.md" },
    { "from": "Inbox.md", "markdown": "Notes/100% done.md", "expect": "Notes/100% done.md", "why": "a % that starts no sequence is kept" },
    { "from": "Inbox.md", "markdown": "Notes/50%2525%20off.md", "expect": "Notes/50%25 off.md" },
    { "from": "Inbox.md", "markdown": "Notes/50%25 off.md", "expect": "Notes/50%25 off.md", "why": "decoded it names nothing, so it is read as written" },
    { "from": "Inbox.md", "markdown": "Notes/My%20note%20%28draft%29.md", "expect": "Notes/My note (draft).md" },
    { "from": "Inbox.md", "markdown": "Notes/My note (draft).md", "expect": "Notes/My note (draft).md" },
    { "from": "Inbox.md", "markdown": "%C3%9Cn%C3%AFcode/Caf%C3%A9.md", "expect": "Ünïcode/Café.md" },
    { "from": "Inbox.md", "markdown": "Ünïcode/café", "expect": "Ünïcode/Café.md" },
    { "from": "Inbox.md", "markdown": "Notes/%FF.md", "expect": null, "why": "not valid text once decoded, and no file has that name as written" },
    { "from": "Inbox.md", "markdown": "Notes/Old%20Style", "expect": "Notes/Old Style.markdown" },
    { "from": "Inbox.md", "markdown": "Inbox.md#Today", "expect": "Inbox.md", "fragment": "#Today" },
    { "from": "Inbox.md", "markdown": "Inbox.md#Today \"t\"", "expect": "Inbox.md", "fragment": "#Today" },
    { "from": "Inbox.md", "markdown": "paper.pdf#page=3", "expect": "paper.pdf", "fragment": "#page=3" },
    { "from": "Inbox.md", "markdown": "#Top", "expect": null, "fragment": "#Top", "why": "a heading in the note itself" },
    { "from": "Inbox.md", "markdown": "https://example.com/Plan.md", "expect": null, "external": true },
    { "from": "Inbox.md", "markdown": "mailto:plan@example.com", "expect": null, "external": true },
    { "from": "Inbox.md", "markdown": "data:image/png;base64,AAAA", "expect": null, "external": true },
    { "from": "Inbox.md", "markdown": "obsidian://open?vault=x", "expect": null, "external": true },
    { "from": "Projects/Notes.md", "wiki": "Plan", "expect": "Archive/Plan.md", "why": "three notes share the name; the first in listing order wins" },
    { "from": "Projects/Notes.md", "wiki": "./Plan", "expect": "Projects/Plan.md", "why": "./ is the folder of the note the link is in" },
    { "from": "Projects/Notes.md", "wiki": "./Plan.md", "expect": "Projects/Plan.md" },
    { "from": "Projects/Notes.md", "wiki": "../Plan", "expect": "Plan.md", "why": "the note at the top that no name or path reaches" },
    { "from": "Projects/Notes.md", "wiki": "../../Plan", "expect": null },
    { "from": "Projects/Notes.md", "wiki": "./Deep/Draft", "expect": "Projects/Deep/Draft.md" },
    { "from": "Projects/Notes.md", "wiki": "Deep/Draft", "expect": null, "why": "without ./ a path is from the top of the vault" },
    { "from": "Projects/Notes.md", "wiki": "Deep/Spec", "expect": "Deep/Spec.md" },
    { "from": "Projects/Notes.md", "wiki": "./img/photo.png", "expect": "Projects/img/photo.png" },
    { "from": "Projects/Notes.md", "wiki": "./photo.png", "expect": "attachments/photo.png", "why": "nothing is at Projects/photo.png, so it is found by name as before" },
    { "from": "Projects/Notes.md", "wiki": "photo.png", "expect": "attachments/photo.png" },
    { "from": "Inbox.md", "wiki": "./Plan", "expect": "Plan.md" },
    { "from": "Inbox.md", "wiki": ".\\Plan", "expect": "Plan.md", "why": "backslashes are read as path separators" },
    { "from": "Projects/Deep/Spec.md", "wiki": "../img/chart.png", "expect": "Projects/img/chart.png" },
    { "from": "Projects/Deep/Spec.md", "wiki": "../../Ünïcode/café", "expect": "Ünïcode/Café.md" }
  ]
}
